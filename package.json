{
  "name": "mirrorstar-wallpaper",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts vitest.config.ts eslint.config.js --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "cargo build -p mirrorstar-wp-proc && tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.11.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "terser": "^5.37.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.21.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
