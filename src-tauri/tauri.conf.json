{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2.11.2/crates/tauri-config-schema/schema.json",
  "productName": "MirrorStar Wallpaper",
  "identifier": "com.mirrorstar.wallpaper",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../mpv/mpv.exe": "mpv/mpv.exe",
      "../mpv/license": "mpv/license",
      "../target/release/mirrorstar-ui.exe": "mirrorstar-ui.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}